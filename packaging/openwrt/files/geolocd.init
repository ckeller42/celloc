#!/bin/sh /etc/rc.common
# procd init for geolocd. The daemon reads its config (incl. the OpenCelliD key)
# from uci itself, so nothing secret is passed on the command line.
# shellcheck disable=SC2034 # START/STOP/USE_PROCD are read by /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/geolocd
	# threshold 3600s, timeout 5s, retry 0 = never give up. A bare `respawn`
	# means 3600 5 5: after 5 quick exits (e.g. log.Fatalf on a missing
	# google_key) procd stops respawning and the service stays dead until a
	# manual restart. With 0 it keeps retrying every 5s until the key is set.
	procd_set_param respawn 3600 5 0
	# procd hashes this file into the instance. On `reload` (which, with no
	# reload_service, is plain `start`) a changed hash makes procd restart the
	# instance; without it the instance is unchanged and nothing happens.
	procd_set_param file /etc/config/geolocd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# `uci commit geolocd` + `reload_config` -> /etc/init.d/geolocd reload.
	# Effective only because of `procd_set_param file` above.
	procd_add_reload_trigger "geolocd"
}
